# ============================================================
#  CleanIT — Flutter Environment Variables
#  Copy this file to .env and fill in your actual values.
#  NEVER commit the .env file to version control.
# ============================================================
#
#  For the backend server environment variables, see:
#  backend/.env.example
# ============================================================

# ── QR Code Signing ──
# Generate with: openssl rand -hex 32
# Must match the value set in the backend .env
QR_SIGNING_SECRET=your_random_32_char_hex_string_here

# ── Firebase ──
# Firebase project ID (from Firebase Console → Project Settings → General)
FIREBASE_PROJECT_ID=your_firebase_project_id
