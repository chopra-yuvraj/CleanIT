# ============================================================
#  CleanIT Backend — Environment Variables
# ============================================================

# MongoDB Atlas connection string (replace with your own)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/cleanit?retryWrites=true&w=majority

# JWT secret for authentication tokens (use a long random string)
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production

# JWT expiry (e.g., 7d, 24h, 30d)
JWT_EXPIRY=7d

# Server port
PORT=3000

# QR Code signing secret (must match Flutter app)
QR_SIGNING_SECRET=your_qr_signing_secret_here

# Firebase Project ID (for FCM — optional)
FIREBASE_PROJECT_ID=cleanit-b249a
